# HTTPS reverse proxy (automatic Let's Encrypt certificates).
# Used by: docker compose --profile https up -d
#   $DOMAIN            the Studio website itself
#   any other host     published websites of projects (domains bound in the Studio):
#                      certificates are issued on demand, only for hosts the Studio
#                      confirms (bound domains, <name>.$SITES_BASE_DOMAIN)
{
	on_demand_tls {
		ask http://studio:8081/.well-known/ai-everything/tls-allowed
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy studio:8080
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy studio:8081
}

http:// {
	redir https://{host}{uri} 308
}
