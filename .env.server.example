# Everything Studio on a public web server — copy to .env and fill in the values marked CHANGE.
#   cp .env.server.example .env
#   docker compose up -d --build         (COMPOSE_FILE below adds docker-compose.server.yml)
# Every setting of .env.example works here too.

# both files: the base setup + the public-server ports (80/443 on IPv4 and IPv6)
COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml

# --- 1. The Studio's own address ----------------------------------------------------------
# CHANGE: a host name whose DNS A record (and AAAA for IPv6) points to this server. The Studio
# is then at https://<this name>/ with its own certificate; its plain port 8080 stays on the
# server itself. PUBLIC_URL is the same name with https://.
STUDIO_DOMAIN=studio.example.com
PUBLIC_URL=https://studio.example.com

# --- 2. HTTPS certificates (Let's Encrypt) ------------------------------------------------
# Certificates are requested by themselves for the Studio's domain and every website domain,
# and renewed in time. "yes" accepts the certificate authority's terms of service:
#   https://letsencrypt.org/repository/
ACME_AGREE_TOS=yes
# CHANGE: the contact address for the certificate authority
ACME_EMAIL=you@example.com

# --- 3. The first account ----------------------------------------------------------------
# CHANGE: created at the first start (use a long password; change it on the website later).
# Without ADMIN_PASSWORD the first person who opens the website creates the admin account —
# from the internet that needs the setup code from the server log:
#   docker compose logs studio | grep "setup code"
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# only admins create accounts
REGISTRATION=closed

# --- 4. Addresses for websites and WordPress sites (recommended) ---------------------------
# With a wildcard DNS record  *.apps.example.com → this server  every published website and
# every WordPress site gets <name>.apps.example.com by itself (plus its own domains).
# Use a domain of its own here — not a subdomain of the Studio's domain.
# No domain at hand? A wildcard DNS service works too:  SITES_BASE_DOMAIN=203.0.113.7.sslip.io
SITES_BASE_DOMAIN=

# --- Secrets -----------------------------------------------------------------------------
# Encrypts stored keys and certificates. Left empty, one is generated at the first start and
# kept in the data volume — fine for one server. Set your own (48+ random characters) when you
# want to be able to rebuild the server from a backup of the database alone.
APP_SECRET=

# --- Limits worth a look on a shared server -----------------------------------------------
MAX_RUNS_PER_USER=2
MAX_SERVICES_PER_USER=3
MAX_SITES_PER_USER=10
MAX_WORDPRESS_PER_USER=5
# processes + threads of the whole container (protects the host from a runaway program)
STUDIO_PIDS_LIMIT=16384
