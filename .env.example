# Optional: copy to .env and edit (cp .env.example .env). Without a .env file
# the defaults below are used — everything works out of the box.

# --- Website ---------------------------------------------------------------
APP_NAME=Everything Studio
# 127.0.0.1 = only this computer. 0.0.0.0 = reachable from your network.
# On a public web server start from .env.server.example instead (ports 80/443, HTTPS
# certificates, the Studio under its own domain) — see "Running on a public server" in the README.
STUDIO_BIND=127.0.0.1
STUDIO_PORT=8080
# Public address when running behind a reverse proxy (used for origin checks)
PUBLIC_URL=
# true when a reverse proxy (Caddy/nginx/Traefik) sits in front of the Studio
TRUST_PROXY=false
COOKIE_SECURE=auto
# Domain for the optional built-in HTTPS proxy (docker compose --profile https up -d)
DOMAIN=

# Encrypts saved Claude keys/tokens and signs preview links. Use 48+ random
# characters and never change it afterwards (saved keys would become unreadable).
# Left empty, one is generated once and kept in the data volume (home/.studio/app-secret).
APP_SECRET=

# Optional: create this admin account on the first start. Otherwise the first
# person who registers on the website becomes admin.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# open = anyone who can reach the site may register; closed = admins add users
REGISTRATION=closed

# --- Database ----------------------------------------------------------------
# The image contains its own database (MariaDB) — nothing to configure; its data
# is in the studio-db volume and its password is generated on the first start.
# Only to use an EXTERNAL MySQL/MariaDB server instead, fill in:
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=studio
MYSQL_USER=studio
MYSQL_PASSWORD=

# --- Claude ------------------------------------------------------------------
# What Claude may do without asking in new projects:
#   bypass      = autonomous (each user is sandboxed in an own Linux account)
#   acceptEdits = edits automatic, commands need approval in the chat
#   ask         = approve everything
#   plan        = read-only planning
DEFAULT_PERMISSION_MODE=bypass
# Default model alias for everybody (fable, opus, sonnet, haiku) — empty = account default
DEFAULT_MODEL=

# --- Android SDK (installed at runtime into the data volume, never baked into the image) ---
# Normally an admin installs it on the website (Admin → Android SDK) and accepts
# Google's license there. For unattended setups, accepting here is the same act:
#   https://developer.android.com/studio/terms
ANDROID_SDK_ACCEPT_LICENSE=
ANDROID_SDK_AUTO_INSTALL=false
# Explicit packages instead of "newest stable", e.g.:
#   platform-tools platforms/android-36 build-tools/36.0.0
ANDROID_SDK_PACKAGES=

# --- Limits ------------------------------------------------------------------
MAX_RUNS_PER_USER=2
MAX_TERMINALS_PER_USER=4
RUN_TIMEOUT_MINUTES=60
TERMINAL_IDLE_MINUTES=30
UPLOAD_LIMIT_MB=500
TRASH_DAYS=7
PACK_LIMIT_MB=4096

# --- Servers (Node.js backends of projects: multiplayer, saves, leaderboards …) ---
# Claude writes them in a project's server/ folder; the Studio runs each one as the
# project owner's sandbox user and makes it reachable at <Studio address>/srv/<name>/
# (HTTP + WebSocket, through the Studio's own port). Public by design: apps connect to them.
SERVICES_ENABLED=true
MAX_SERVICES_PER_USER=3
SERVICE_MEMORY_MB=512

# --- Websites (publish web apps and games of projects on your own domains) -------
# A second port serves the published websites, chosen by the domain in the request.
# Domains point to this server (DNS A/AAAA record); users add them in a project's Website tab.
# Local default: http://<name>.localhost:8081 on this computer. On a web server:
#   SITES_BIND=0.0.0.0  SITES_PORT=80  SITES_HTTPS_PORT=443
SITES_ENABLED=true
SITES_BIND=127.0.0.1
SITES_PORT=8081

# HTTPS for the websites is built in: a second port serves them with TLS and the Studio
# manages one certificate per domain — automatic (Let's Encrypt; needs the domain pointing
# here and port 80 reachable from the internet), your own (upload) or self-signed.
# Users manage it in a project's Website tab, admins in Admin → HTTPS.
SITES_TLS=true
SITES_HTTPS_PORT=8443
# Automatic certificates: contact e-mail for the certificate authority. ACME_AGREE_TOS=yes
# accepts the authority's terms of service here instead of in Admin → HTTPS.
ACME_EMAIL=
ACME_AGREE_TOS=
# Another ACME certificate authority instead of Let's Encrypt (its directory URL):
ACME_DIRECTORY_URL=
# Serve the Studio itself over HTTPS on that port under this host name (optional; Admin → HTTPS):
STUDIO_DOMAIN=
# Alternative: the Caddy proxy of the "https" profile (or your own proxy) terminates TLS —
# then set SITES_HTTPS=true (the built-in HTTPS switches itself off).
SITES_HTTPS=false
# Optional: every website also gets <name>.<base domain> — needs a wildcard DNS record
# *.<base domain> → this server. Use a domain of its own, NOT a subdomain of the Studio's.
SITES_BASE_DOMAIN=
MAX_SITES_PER_USER=10
SITE_MAX_MB=500
# new certificate orders per hour for the whole Studio (the certificate authority counts them)
ACME_ORDERS_PER_HOUR=40

# --- WordPress (the WordPress area: a real WordPress site per project) ------------------------
# WordPress is downloaded from wordpress.org when a user sets a site up. Each site has its own
# database (in the built-in database) and its own PHP, which runs as the owner's sandbox user,
# starts with the first visitor and stops when nobody visits. Sites are reached on the website
# ports under <name>.localhost, <name>.<SITES_BASE_DOMAIN> and the user's own domains.
WORDPRESS_ENABLED=true
MAX_WORDPRESS_PER_USER=5
# PHP memory limit and worker processes of one site, largest upload
WORDPRESS_MEMORY_MB=256
WORDPRESS_MAX_WORKERS=6
WORDPRESS_UPLOAD_MB=64
# stop a site's PHP after this many minutes without a visitor (0 = keep it running)
WORDPRESS_IDLE_MINUTES=60
# true: the PHP of a site can only reach its project folder and has no shell functions
WORDPRESS_PHP_HARDENING=true
# Only with an EXTERNAL MySQL server (MYSQL_HOST): an account that may create databases and users
WORDPRESS_DB_ADMIN_USER=
WORDPRESS_DB_ADMIN_PASSWORD=

# --- Versioning (numbered releases of projects) ---------------------------------------------
# largest exports/ folder that is kept with a release, in MB
RELEASE_EXPORTS_MB=1024

# --- More AI providers (besides Claude Code) -----------------------------------
# OpenAI Codex, Google Gemini CLI and OpenCode (OpenAI, Google, OpenRouter, Groq, Mistral,
# DeepSeek, xAI, local and free models …) run over the Agent Client Protocol. Admins switch
# them on in Admin → AI providers; that downloads the official npm packages into the data
# volume (several 100 MB each). Users connect their own accounts / keys on the Account page.
# Switched on at the first start (comma separated), e.g.: codex,gemini,opencode
AGENTS=
AGENTS_AUTO_UPDATE=true
# an AI process stays up between the messages of a chat for this long
AGENT_IDLE_MINUTES=10

# --- Claude Code --------------------------------------------------------------
# Anthropic's Claude Code is NOT part of the image: the Studio downloads the official
# npm package on first start into the data volume (needs internet). "latest" keeps it
# up to date (checked at start and daily); an exact version (e.g. 2.1.319) pins it.
CLAUDE_CODE_VERSION=latest
CLAUDE_CODE_AUTO_INSTALL=true
CLAUDE_CODE_AUTO_UPDATE=true

# --- Image build (docker compose build) --------------------------------------
# true = put Claude Code into the image at build time. ONLY for private images —
# never publish such an image (Claude Code is Anthropic's proprietary software).
INSTALL_CLAUDE_CODE=false
# JDK + Gradle for Android apps (the SDK itself is installed at runtime, see above)
INSTALL_ANDROID=true
# .NET SDK for Windows software (~800 MB)
INSTALL_DOTNET=true
# mingw-w64 C/C++ cross compilers + NSIS
INSTALL_WINDOWS_CROSS=true
# Wine to smoke-test Windows programs (~1 GB)
INSTALL_WINE=false
# Playwright + Chromium headless browser for Claude
INSTALL_BROWSERS=true
# PHP (FPM) + WP-CLI for the WordPress area (~120 MB)
INSTALL_WORDPRESS=true
# processes + threads the whole container may have
STUDIO_PIDS_LIMIT=16384
STUDIO_IMAGE=ai-everything:latest
