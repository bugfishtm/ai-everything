{
  "id": "basic-3d",
  "name": "Basic 3D",
  "version": "1.1.0",
  "type": "3d",
  "description": "Starter kit for studio-3d: PBR materials (plain and textured: bricks, floorboards, roof tiles, cobblestone …), nature shapes with parameters (tree, pine, rock, bush), props (crate, barrel, fence, lamp post) and a campfire prefab. The props are built from the text sources in src/.",
  "author": "Everything Studio",
  "license": "CC0-1.0",
  "tags": ["low-poly", "nature", "props", "materials", "textures"],
  "software": ["studio-3d"],
  "docs": "README.md",
  "items": [
    { "id": "tree", "kind": "plugin", "name": "Tree (shape)", "file": "plugins/nature.py", "tags": ["tree", "nature", "deciduous"],
      "meta": { "target": "studio-3d", "shape": "tree", "params": { "height": 4.0, "canopy": 1.6, "trunk": 0.18, "blobs": 4, "seed": 1 } } },
    { "id": "pine", "kind": "plugin", "name": "Pine tree (shape)", "file": "plugins/nature.py", "tags": ["tree", "pine", "conifer", "nature"],
      "meta": { "target": "studio-3d", "shape": "pine", "params": { "height": 5.0, "radius": 1.3, "layers": 4, "trunk": 0.15, "seed": 1 } } },
    { "id": "rock", "kind": "plugin", "name": "Rock (shape)", "file": "plugins/nature.py", "tags": ["rock", "stone", "boulder", "nature"],
      "meta": { "target": "studio-3d", "shape": "rock", "params": { "size": 1.0, "detail": 2, "roughness": 0.25, "flatness": 0.7, "seed": 1 } } },
    { "id": "bush", "kind": "plugin", "name": "Bush (shape)", "file": "plugins/nature.py", "tags": ["bush", "shrub", "nature"],
      "meta": { "target": "studio-3d", "shape": "bush", "params": { "size": 0.8, "blobs": 3, "seed": 1 } } },
    { "id": "crate", "kind": "model", "name": "Wooden crate (1 m)", "file": "models/crate.glb", "tags": ["crate", "box", "prop", "wood"], "meta": { "source": "src/crate.scene.yaml" } },
    { "id": "barrel", "kind": "model", "name": "Barrel", "file": "models/barrel.glb", "tags": ["barrel", "prop", "wood"], "meta": { "source": "src/barrel.scene.yaml" } },
    { "id": "fence", "kind": "model", "name": "Fence section (2 m)", "file": "models/fence.glb", "tags": ["fence", "prop", "wood"], "meta": { "source": "src/fence.scene.yaml" } },
    { "id": "lamp-post", "kind": "model", "name": "Street lamp (3 m)", "file": "models/lamp-post.glb", "tags": ["lamp", "light", "street", "prop"], "meta": { "source": "src/lamp-post.scene.yaml" } },
    { "id": "campfire", "kind": "prefab", "name": "Campfire", "file": "prefabs/campfire.scene.yaml", "tags": ["fire", "camp", "prop"] },
    { "id": "oak", "kind": "material", "name": "Oak wood", "file": "materials/oak.json", "tags": ["wood"] },
    { "id": "pine-needles", "kind": "material", "name": "Pine needles", "file": "materials/pine-needles.json", "tags": ["foliage", "green"] },
    { "id": "bark", "kind": "material", "name": "Bark", "file": "materials/bark.json", "tags": ["wood", "tree"] },
    { "id": "granite", "kind": "material", "name": "Granite", "file": "materials/granite.json", "tags": ["stone", "rock"] },
    { "id": "mossy-rock", "kind": "material", "name": "Mossy rock", "file": "materials/mossy-rock.json", "tags": ["stone", "rock", "moss"] },
    { "id": "clay-roof", "kind": "material", "name": "Clay roof tiles", "file": "materials/clay-roof.json", "tags": ["roof", "clay"] },
    { "id": "sand", "kind": "material", "name": "Sand", "file": "materials/sand.json", "tags": ["ground", "beach"] },
    { "id": "water", "kind": "material", "name": "Water", "file": "materials/water.json", "tags": ["water", "transparent"] },
    { "id": "iron", "kind": "material", "name": "Iron", "file": "materials/iron.json", "tags": ["metal"] },
    { "id": "ember", "kind": "material", "name": "Glowing ember", "file": "materials/ember.json", "tags": ["fire", "emissive", "glow"] },
    { "id": "brick-wall", "kind": "material", "name": "Brick wall (textured)", "file": "materials/brick-wall.json", "tags": ["wall", "brick", "textured"] },
    { "id": "floorboards", "kind": "material", "name": "Floorboards (textured)", "file": "materials/floorboards.json", "tags": ["wood", "floor", "planks", "textured"] },
    { "id": "wood-grain", "kind": "material", "name": "Wood grain (textured)", "file": "materials/wood-grain.json", "tags": ["wood", "textured"] },
    { "id": "roof-tiles", "kind": "material", "name": "Roof tiles (textured)", "file": "materials/roof-tiles.json", "tags": ["roof", "clay", "textured"] },
    { "id": "cobblestone", "kind": "material", "name": "Cobblestone (textured)", "file": "materials/cobblestone.json", "tags": ["stone", "ground", "street", "textured"] },
    { "id": "floor-tiles", "kind": "material", "name": "Floor tiles (textured)", "file": "materials/floor-tiles.json", "tags": ["floor", "tiles", "checker", "textured"] },
    { "id": "concrete-rough", "kind": "material", "name": "Rough concrete (textured)", "file": "materials/concrete-rough.json", "tags": ["concrete", "wall", "textured"] },
    { "id": "meadow", "kind": "material", "name": "Meadow grass (textured)", "file": "materials/meadow.json", "tags": ["grass", "ground", "nature", "textured"] },
    { "id": "rusty-metal", "kind": "material", "name": "Rusty metal (textured)", "file": "materials/rusty-metal.json", "tags": ["metal", "rust", "textured"] }
  ]
}
